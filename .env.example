# Runtime settings for Domain Mapper (copy to .env; .env is gitignored).
# These values are LOCAL PLACEHOLDERS only. Never commit real endpoints, keys or
# provider names to this public repository (D-003).
DM_LLM_GATEWAY_URL=http://localhost:8000/v1
DM_LOCAL_MODEL=local-model
DM_EMBEDDING_URL=http://localhost:8001/v1
DM_RERANKER_URL=http://localhost:8002/v1
# Optional; leave empty to run without a cloud model.
DM_CLOUD_LLM_API_KEY=
DM_CLOUD_LLM_MODEL=cloud-model
# Per-run cloud LLM spend budget in USD (>= 0).
DM_LLM_BUDGET_USD=10.0
# Maximum concurrent crawl requests per host (>= 1).
DM_MAX_CRAWL_CONCURRENCY=2

# PostgreSQL (docker compose `db` service). LOCAL PLACEHOLDERS only.
# DM_POSTGRES_PASSWORD is required: the compose stack refuses to start without it.
DM_POSTGRES_DB=domain_mapper
DM_POSTGRES_USER=domain_mapper
DM_POSTGRES_PASSWORD=
DM_POSTGRES_PORT=5432
# Connection URL for the engine's run/work-unit tables. Defaults to the local
# compose placeholders above, without a password; set the password here in .env.
# DM_DATABASE_URL=postgresql+psycopg://domain_mapper:<password>@localhost:5432/domain_mapper
# MinIO (opt-in compose profile `minio`); the raw-storage decision is still open.
DM_MINIO_ROOT_USER=
DM_MINIO_ROOT_PASSWORD=
# Discovery search backend (D-004): self-hosted SearXNG JSON API. Placeholder only;
# the real endpoint lives in .env.
SEARXNG_URL=http://localhost:8888
# Raw fetched-bytes store root (D-005); content-addressed by sha256. Gitignored.
RAW_STORE_DIR=data/raw/
